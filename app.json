{
  "expo": {
    "name": "Family Cookbook",
    "slug": "family-cookbook",
    "scheme": "family-cookbook",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashscreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.watsonsweb.Grandmascookbook",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Grandma's Cookbook uses your camera to capture photos of your family recipes.",
        "NSPhotoLibraryUsageDescription": "Grandma's Cookbook accesses your photo library so you can add photos to your recipes and profile.",
        "NSPhotoLibraryAddUsageDescription": "Grandma's Cookbook saves recipe photos to your photo library."
      },
      "buildNumber": "19"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-build-properties",
      [
        "react-native-iap",
        {
          "paymentProvider": "Apple"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1017ef8-f1ac-4f84-959c-85ea7d29887d"
      }
    },
    "owner": "dangelo137"
  }
}
